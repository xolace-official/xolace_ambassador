    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "convex": "^1.46.0",
    "coolshapes-react": "^1.0.1",
    "lucide-react": "^0.563.0",
